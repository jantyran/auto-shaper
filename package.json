{
  "name": "auto-shaper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "server/firebase.mjs",
  "license": "MIT",
  "description": "AIがカラムを読み取り、インポート用フォーマットへ自動整形するブラウザ完結型データシェイパー",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:prod": "node --env-file=.env.production server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@neondatabase/serverless": "^0.10.4",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "firebase-functions": "^6.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
