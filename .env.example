# Auto Shaper の環境変数サンプル(OSS向けテンプレート)。
#
# ローカル開発(`npm run dev` / `npm run preview`)は何も設定しなくてもそのまま動きます
# (SQLite・全オリジン許可のCORS・同一オリジンAPIが既定値のため)。
#
# 本番相当の設定を試す場合は、このファイルを `.env.production` としてコピーし、
# 実際の値を書いてください(`.env.production` は .gitignore 対象で、リポジトリには
# コミットされません)。
#
#   cp .env.example .env.production
#   npm run server:prod

# ── サーバー全般(server/index.mjs) ──

# API サーバーの待受ポート。既定: 8787
PORT=8787

# ── DBドライバ(server/storage/) ──

# 'sqlite'(既定・ローカル向け) または 'postgres'(Neon等・サーバーレス向け)
DB_DRIVER=sqlite

# DB_DRIVER=sqlite のときのみ有効。DBファイルの保存先ディレクトリ。
# 既定: server/data
# DATA_DIR=./server/data

# DB_DRIVER=postgres のとき必須。Neon等の接続文字列(sslmode=require 推奨)。
# Firebase Cloud Functions にデプロイする場合はここではなく
# `firebase functions:secrets:set DATABASE_URL` で渡してください(README参照)。
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── CORS(server/app.mjs) ──

# フロントを別オリジンで配信する場合に限定したいオリジン。既定は '*'(全許可・ローカル向け)。
# 公開ネットワークに晒す場合は実際に使うオリジンへ限定してください(README参照)。
# CORS_ORIGIN=https://your-app.example.com

# ── フロントエンド(Vite が自動で読み込む。VITE_ 接頭辞のみ有効) ──

# API サーバーの絶対URL。フロントと API が同一オリジンでない場合のみ設定。
# 通常(Vite dev/preview に同梱、または Firebase Hosting の rewrite)は空欄のままで大丈夫です。
# VITE_API_BASE=https://api.your-app.example.com
